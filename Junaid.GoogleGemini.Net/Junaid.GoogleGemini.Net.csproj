<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Shared settings (LangVersion, Nullable, analyzers, package identity, deterministic builds)
		come from ../Directory.Build.props. This file only declares what is specific to producing
		THIS package.
	-->

	<PropertyGroup>
		<!--
			Multi-target: net8.0 (current LTS) and net9.0 (current STS). netstandard2.0 is planned
			for Phase 1, where the transport rewrite lets us add the needed polyfills cleanly
			(IAsyncEnumerable, CancellationToken stream overloads).
		-->
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>

		<!-- Package metadata -->
		<Title>Junaid.GoogleGemini.Net</Title>
		<Description>A production-ready .NET client for the Google Gemini API: resilient (retries + rate limiting), observable, and DI-native, with first-class ASP.NET Core ergonomics.</Description>
		<PackageTags>GoogleGemini;Gemini;GenerativeAI;AI;LLM;GoogleAI;dotnet;aspnetcore;IChatClient</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>6.0.0-alpha.1</Version>
		<PackageReleaseNotes>
			6.0 is a modernization release with breaking changes. Phase 1 (foundation + correctness):
			- Fixed retries: resilience now runs on the HttpClient pipeline (Microsoft.Extensions.Http.Resilience);
			  the previous hand-rolled retry reused disposed content and never worked.
			- Real Server-Sent-Events streaming exposed as IAsyncEnumerable&lt;GenerateContentResponse&gt;
			  (callback overloads retained); proper cancellation and timeout handling throughout.
			- Unified, source-generated JSON serialization (AOT-friendly) with one consistent wire contract.
			- Typed exception hierarchy (GeminiApiException, GeminiRateLimitException, GeminiTimeoutException,
			  GeminiSerializationException, GeminiContentException) replacing string-matched errors.
			- Honest response accessors (Text(), TryGetText, GetTextOrThrow, FinishReason, Usage) instead of
			  placeholder strings.
			- Multi-targets net8.0 and net9.0; defaults to the v1beta API; refreshed model constants.
			BREAKING: response DTOs are PascalCase; streaming returns IAsyncEnumerable; exception types changed.
		</PackageReleaseNotes>

		<!--
			Production settings for the package itself:
			- XML docs ship with the package so consumers get IntelliSense.
			- A .snupkg symbol package + embedded untracked sources enable step-through debugging
			  and Source Link navigation from a consumer's IDE straight to our source on GitHub.
			- Pack on Release build so `dotnet build -c Release` yields a ready-to-publish .nupkg.
		-->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- The shipped library must stay warning-clean. Examples/tests don't set this. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- TEMPORARY: suppress "missing XML comment" until the public surface is fully documented
		     in Phase 2/3. Docs are still generated for members that have them. -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!-- Versions aligned with Microsoft.Extensions.Http.Resilience's transitive requirements
		     (avoids NU1605 package-downgrade errors). -->
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
		<!-- Modern resilience (Polly v8 under the hood). Replaces the deprecated Polly.Extensions.Http
		     and the hand-rolled retry cache: resilience now lives on the HttpClient pipeline. -->
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
		<PackageReference Include="System.Threading.RateLimiting" Version="8.0.0" />
	</ItemGroup>

</Project>
